{
    "name": "portfolio-astro",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "start": "node ./dist/server/entry.mjs",
        "docker:build": "docker build -t aditya04tripathi .",
        "docker:up": "docker compose up --build -d && echo http://localhost:49228",
        "docker:down": "docker compose down",
        "docker:prod:pull": "docker compose -f docker-compose.prod.yml pull",
        "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d && echo http://localhost:49228",
        "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
        "lint": "eslint .",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "@astrojs/mdx": "^4.3.1",
        "@astrojs/node": "^9.4.0",
        "@astrojs/sitemap": "^3.7.2",
        "@astrojs/svelte": "^7.2.5",
        "@tailwindcss/vite": "^4.1.12",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "lucide-svelte": "^1.0.1",
        "slugify": "^1.6.6",
        "svelte": "^5.55.4",
        "svelte-sonner": "^1.1.0",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.7",
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^20",
        "astro": "^5.7.0",
        "astro-eslint-parser": "^3.0.0",
        "biome": "^0.3.3",
        "eslint": ">=10.4",
        "eslint-config-xo": "^1.0.0",
        "eslint-plugin-astro": "^3.1.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-svelte": "^3.22.0",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "prettier": ">=3",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte-eslint-parser": "^1.8.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.66.0"
    }
}
