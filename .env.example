# Gmail SMTP contact form. Keep credentials server-side.
# Enable Google 2-Step Verification, then create a Gmail app password.
# Set the Gmail address and app password below in private .env.local.
# Restart the dev server after changing credentials.
# SMTP uses smtp.gmail.com:465 with TLS; CONTACT_EMAIL defaults to the portfolio email.
# The form has a honeypot and best-effort in-process limits (5 sends/IP and
# 30 sends total per 10 minutes). Limits reset on restart and are not shared
# across instances. A deployment
# proxy must overwrite forwarding headers; use a shared limiter for multi-instance abuse control.

GMAIL_SMTP_USER=aditya.tripathi0404@gmail.com
GMAIL_SMTP_APP_PASSWORD=
CONTACT_EMAIL=adityatripathi.at04@gmail.com
# Optional deployed form origin when a reverse proxy rewrites the host header.
CONTACT_ALLOWED_ORIGIN=

# Public Analytics stream. Tracking is enabled in production builds only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-8QFJP7YRD2
