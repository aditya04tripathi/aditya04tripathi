:{$PORT:49228} {
	root * /srv
	encode zstd gzip

	import /etc/caddy/markdown-tokens.caddy

	header Vary Accept

	@markdown {
		header Accept *text/markdown*
		not path /_astro/* *.css *.js *.mjs *.map *.png *.jpg *.jpeg *.webp *.svg *.ico *.xml *.txt *.woff *.woff2 *.ttf
	}

	handle @markdown {
		try_files {path}.md {path}/index.md {path}index.md
		header Content-Type "text/markdown; charset=utf-8"
		header x-markdown-tokens {markdown_tokens}
		file_server
	}

	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
